{
  "info": {
    "name": "IMovies MERN Stack API Collection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Auth - Login Admin",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "http://localhost:5000/api/auth/login",
          "host": [
            "http://localhost:5000"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"admin@imovies.com\", \"password\": \"password123\"}"
        }
      }
    },
    {
      "name": "2. Movies - Search & Filter",
      "request": {
        "method": "GET",
        "url": {
          "raw": "http://localhost:5000/api/movies?genre=Sci-Fi&language=English",
          "host": [
            "http://localhost:5000"
          ],
          "path": [
            "api",
            "movies"
          ]
        }
      }
    },
    {
      "name": "3. Shows - Get Show & 48 Seats",
      "request": {
        "method": "GET",
        "url": {
          "raw": "http://localhost:5000/api/shows/:showId",
          "host": [
            "http://localhost:5000"
          ],
          "path": [
            "api",
            "shows",
            ":showId"
          ]
        }
      }
    },
    {
      "name": "4. Bookings - Book Seats & Pay",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer <JWT_TOKEN>"
          }
        ],
        "url": {
          "raw": "http://localhost:5000/api/bookings",
          "host": [
            "http://localhost:5000"
          ],
          "path": [
            "api",
            "bookings"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"showId\": \"<SHOW_ID>\", \"seatNumbers\": [\"C4\", \"C5\"], \"paymentMethod\": \"UPI\"}"
        }
      }
    }
  ]
}